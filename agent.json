{
  "$schema": "http://desirecore/schemas/agent.json",
  "version": "1.3.1",
  "name": "法域合规官",
  "description": "O3 并行隔离的 CN-only 法域支路。先判服务范围，再按本轮固定规则清单分批产出适用性事实和显式覆盖债务；域外仅通用治理与转介，只向 Lead 交付。",
  "author": "DesireCore",
  "avatar": {
    "char": "域",
    "color": "purple"
  },
  "llm": {
    "routingMode": "smart",
    "smart": {
      "profile": {
        "tier": "flagship",
        "requiredCapabilities": [
          "tool_use",
          "long_context"
        ],
        "reasoning": "high"
      }
    },
    "maxRetryDelayMs": 32000
  },
  "capabilities": [
    "jurisdiction-audit",
    "contract-review",
    "governing-law-identification",
    "jurisdiction-pack-merge",
    "mandatory-rule-matching",
    "jurisdiction-conflict-detection",
    "cross-border-data-compliance-check",
    "citation-discipline-enforcement",
    "version-matrix-alignment"
  ],
  "trigger_patterns": [
    "法域",
    "准据法",
    "适用法律",
    "管辖",
    "法域冲突",
    "法域合规",
    "合规稽核",
    "强制性规定",
    "知识包",
    "规则包",
    "中国法",
    "美国法",
    "数据出境",
    "跨境传输",
    "GDPR",
    "PIPL",
    "CCPA",
    "jurisdiction",
    "governing law",
    "choice of law",
    "conflict of laws",
    "jurisdiction pack",
    "mandatory rules",
    "cross-border transfer",
    "compliance audit"
  ],
  "accepts_handoff": true,
  "accepts_messages": true,
  "max_concurrent_sessions": 3,
  "command_authority": {
    "enabled": true,
    "allowed_targets": [
      "contract-review-lead",
      "review-reporter"
    ]
  },
  "default_enabled": {
    "skills": [
      "jurisdiction-audit"
    ],
    "tools": []
  },
  "tool_permissions": {
    "allowed": [
      "Read",
      "Ls",
      "Glob",
      "Grep",
      "Write",
      "Edit",
      "Skill",
      "MathCalc",
      "GenerateUUID",
      "UnderstandImage",
      "AskUserQuestion",
      "Delegate",
      "SendMessage",
      "FileDigest"
    ],
    "denied": [
      "Bash",
      "PowerShell",
      "TerminalControl",
      "HttpRequest",
      "WebFetch",
      "WebSearch",
      "ComputeCredential",
      "ControlDesireCoreGui",
      "BrowserTakeover",
      "RecallConversation",
      "spawn_agent"
    ]
  },
  "network_security": {
    "enableSsrfProtection": true
  },
  "file_security": {
    "restrictToWorkDirs": true
  },
  "compute_credentials": {
    "allowed_providers": []
  },
  "tools": {
    "ask_user_question": {
      "wait_mode": "always_wait"
    }
  },
  "env": {
    "enabled": true,
    "includeWeekday": true,
    "includeLocalTime": true,
    "includeSessionStart": true,
    "includeOs": false,
    "includeRuntime": false,
    "includeManagedRuntimes": false
  }
}
